      <column caption='Risco Rebaixamento Numérico' datatype='real' default-format='p0.00%' name='[Calculation_0704549816692736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(REPLACE([risco_rebaixamento_previsto], &quot;,&quot;, &quot;.&quot;))' />
      </column>
      <column caption='Faixa de Risco' datatype='string' name='[Calculation_0704549842976769]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0704549816692736] &gt;= 0.60 THEN&#13;&#10;    &quot;Muito alto&quot;&#13;&#10;ELSEIF [Calculation_0704549816692736] &gt;= 0.50 THEN&#13;&#10;    &quot;Alto&quot;&#13;&#10;ELSEIF [Calculation_0704549816692736] &gt;= 0.30 THEN&#13;&#10;    &quot;Médio&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Baixo&quot;&#13;&#10;END' />
      </column>
      <column caption='Maior Risco' datatype='boolean' name='[Calculation_0704549847855107]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[risco_rebaixamento_previsto] = { FIXED : MAX([risco_rebaixamento_previsto]) }' />
      </column>
      <column caption='Clubes em risco' datatype='integer' name='[Calculation_0704549852459012]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF FLOAT(REPLACE([risco_rebaixamento_previsto], &quot;%&quot;, &quot;&quot;)) &gt;= 0.50 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Menor Risco' datatype='boolean' name='[Maior Risco (cópia)_0704549874339845]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[risco_rebaixamento_previsto] = { FIXED : MIN([risco_rebaixamento_previsto]) }' />
      </column>
